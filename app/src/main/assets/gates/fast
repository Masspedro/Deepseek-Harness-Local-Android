#!/system/bin/sh
# [dsh-android] fast —— UI 自动化工作流标记（遗留 CLI 兼容）
#
# 只写/删 $DSH_HOME/fast-mode，不改变模型、provider 或 reasoningEffort。
# 多步计划交给本地 loop 执行，避免每次手势重新请求云端决策。
# on/off 不会恢复旧版本已持久化的 off；关标记后须显式重选有效思考档位。
#
#   fast on      标记 UI 工作流
#   fast off     清除工作流标记
#   fast         查询标记是否存在（CLI 不检查 TTL）
#
# 与 fast_mode 工具共享标记；工具读取时检查 30 分钟 TTL 并清理过期标记。
# 幂等；不需要重启引擎。
DSH_HOME="${DSH_HOME:-/data/user/0/app.dsh.mobile/files/dsh-home}"
MARKER="$DSH_HOME/fast-mode"

case "$1" in
  on)
    printf 'enabled %s\n' "$(date +%s)" > "$MARKER" 2>/dev/null
    if [ -f "$MARKER" ]; then
      echo '{"ok":true,"fast":true,"note":"UI workflow hint ON; model/provider/reasoning unchanged. Run `fast off` when done; OFF or expiry does not restore saved reasoning effort from older versions. After OFF, explicitly reselect a valid reasoning effort if needed."}'
    else
      echo '{"ok":false,"error":"cannot write marker: '"$MARKER"'"}'
      exit 2
    fi
    ;;
  off)
    rm -f "$MARKER" 2>/dev/null
    if [ -f "$MARKER" ]; then
      echo '{"ok":false,"error":"cannot remove marker: '"$MARKER"'"}'
      exit 2
    fi
    echo '{"ok":true,"fast":false,"note":"UI workflow hint OFF; model/provider/reasoning unchanged. Does not restore saved reasoning effort from older versions; explicitly reselect a valid reasoning effort if needed."}'
    ;;
  ""|status)
    if [ -f "$MARKER" ]; then
      echo '{"ok":true,"fast":true}'
    else
      echo '{"ok":true,"fast":false}'
    fi
    ;;
  *)
    echo '{"ok":false,"error":"usage: fast [on|off|status]"}' >&2
    exit 64
    ;;
esac
