<?xml version="1.0" encoding="utf-8"?>
<!--
  DSHA-style design tokens for the native shell (auto-generated by the UI port).

  These tokens align the native Android chrome with the DSHA mobile WebUI
  look: indigo business accent, deep dark surfaces, soft borders. Import them
  anywhere with @color/dsha_* instead of scattering raw hex values.
-->
<resources>
    <!-- Brand / accent -->
    <color name="dsha_accent">#FF4F6EF7</color>
    <color name="dsha_accent_soft">#334F6EF7</color>
    <color name="dsha_accent_fg">#FFFFFFFF</color>

    <!-- Surfaces (dark chrome) -->
    <color name="dsha_bg">#FF0F1115</color>
    <color name="dsha_surface">#FF171B22</color>
    <color name="dsha_surface_raised">#FF1C232C</color>
    <color name="dsha_surface_overlay">#FF232B36</color>
    <color name="dsha_toolbar_scrim">#B31A2028</color>

    <!-- Text -->
    <color name="dsha_text_primary">#FFE8ECF2</color>
    <color name="dsha_text_secondary">#FF9AA5B4</color>
    <color name="dsha_text_muted">#FF6B7686</color>

    <!-- Border -->
    <color name="dsha_border">#33FFFFFF</color>
    <color name="dsha_border_strong">#4DFFFFFF</color>

    <!-- Semantic -->
    <color name="dsha_ok">#FF6EE7B7</color>
    <color name="dsha_warn">#FFFFB74D</color>
    <color name="dsha_err">#FFF87171</color>
</resources>
